pipeline {
  agent any

  parameters {
    choice(
      name: 'DATA_ACTION',
      choices: ['replace-data', 'dry-run', 'sql-import', 'csv-import', 'seed-script'],
      description: 'Chon cach cap nhat data'
    )
    string(
      name: 'IMPORT_FILE',
      defaultValue: 'vnsc-data-update.sql',
      description: 'Ten file trong thu muc imports tren server'
    )
    choice(
      name: 'RESTART_API',
      choices: ['yes', 'no'],
      description: 'Restart API sau khi import'
    )
    string(
      name: 'CONFIRM_REPLACE',
      defaultValue: '',
      description: 'Bat buoc nhap YES_REPLACE_PRODUCTION_DATA khi DATA_ACTION=replace-data'
    )
    file(
      name: 'DATA_FILE',
      description: 'Upload file SQL/CSV de cap nhat du lieu production'
    )
  }

  environment {
    PREPARE_SQL = 'scripts/prepare-species-data-import.sql'
    PREPARE_REMOTE = '/tmp/vnsc-prepare-species-data-import.sql'
    TABLE_MANIFEST = 'scripts/data-update-tables.txt'
    TABLE_MANIFEST_REMOTE = '/tmp/vnsc-data-update-tables.txt'
  }

  stages {
    stage('Load Production Config') {
      steps {
        script {
          withCredentials([
            file(
              credentialsId: 'vn-biodiversity-env-docker',
              variable: 'ENV_DOCKER_FILE'
            )
          ]) {
            def dataEnvFile = ".jenkins-data-env-${env.BUILD_NUMBER}"
            bat "copy /Y \"%ENV_DOCKER_FILE%\" \"${dataEnvFile}\""

            def dockerEnvMap = [:]

            readFile(dataEnvFile)
              .split(/\r?\n/)
              .each { line ->
                def trimmed = line.trim()

                if (
                  trimmed &&
                  !trimmed.startsWith('#') &&
                  trimmed.contains('=')
                ) {
                  def separatorIndex = trimmed.indexOf('=')

                  def key = trimmed
                    .substring(0, separatorIndex)
                    .replace('\uFEFF', '')
                    .trim()

                  def value = trimmed
                    .substring(separatorIndex + 1)
                    .trim()

                  dockerEnvMap[key] = value
                }
              }

            def requireDockerEnv = { key ->
              def value = dockerEnvMap[key]?.trim()

              if (!value || value.equalsIgnoreCase('null')) {
                error "${key} is missing or empty in Jenkins credential vn-biodiversity-env-docker."
              }

              return value
            }

            env.PROD_HOST = requireDockerEnv('PROD_HOST')
            env.PROD_USER = requireDockerEnv('PROD_USER')
            env.PROD_APP_DIR = requireDockerEnv('PROD_APP_DIR')
            env.DATA_DB_SERVICE = requireDockerEnv('DATA_DB_SERVICE')
            env.DATA_API_SERVICE = requireDockerEnv('DATA_API_SERVICE')
            env.DATA_DB_USER = requireDockerEnv('DATA_DB_USER')
            env.DATA_DB_NAME = requireDockerEnv('DATA_DB_NAME')
          }
        }
      }
    }

    stage('Prepare Server') {
      steps {
        withCredentials([
          string(
            credentialsId: 'vn-biodiversity-prod-ssh-key-b64',
            variable: 'PROD_SSH_KEY_B64'
          )
        ]) {
          powershell '''
          $ErrorActionPreference = "Stop"

          if ($env:DATA_ACTION -eq "replace-data" -and $env:CONFIRM_REPLACE -ne "YES_REPLACE_PRODUCTION_DATA") {
            throw "DATA_ACTION=replace-data requires CONFIRM_REPLACE=YES_REPLACE_PRODUCTION_DATA"
          }

          $keyFile = Join-Path $env:WORKSPACE ".jenkins-prod-key-$env:BUILD_NUMBER"
          [IO.File]::WriteAllBytes($keyFile, [Convert]::FromBase64String($env:PROD_SSH_KEY_B64))
          icacls $keyFile /inheritance:r | Out-Null
          $account = whoami
          icacls $keyFile /grant:r "${account}:R" | Out-Null

          $server = "$env:PROD_USER@$env:PROD_HOST"
          ssh -i "$keyFile" -o StrictHostKeyChecking=no "$server" "mkdir -p $env:PROD_APP_DIR/imports $env:PROD_APP_DIR/backups"
          '''
        }
      }
    }

    stage('Upload Scripts And Optional Data') {
      steps {
        withCredentials([
          string(
            credentialsId: 'vn-biodiversity-prod-ssh-key-b64',
            variable: 'PROD_SSH_KEY_B64'
          )
        ]) {
          powershell '''
          $ErrorActionPreference = "Stop"

          $keyFile = Join-Path $env:WORKSPACE ".jenkins-prod-key-$env:BUILD_NUMBER"
          if (-not (Test-Path $keyFile)) {
            [IO.File]::WriteAllBytes($keyFile, [Convert]::FromBase64String($env:PROD_SSH_KEY_B64))
            icacls $keyFile /inheritance:r | Out-Null
            $account = whoami
            icacls $keyFile /grant:r "${account}:R" | Out-Null
          }

          $server = "$env:PROD_USER@$env:PROD_HOST"

          scp -i "$keyFile" -o StrictHostKeyChecking=no `
            "$env:WORKSPACE\\$env:PREPARE_SQL" `
            "${server}:${env:PREPARE_REMOTE}"

          scp -i "$keyFile" -o StrictHostKeyChecking=no `
            "$env:WORKSPACE\\$env:TABLE_MANIFEST" `
            "${server}:${env:TABLE_MANIFEST_REMOTE}"

          $uploadFile = $null

          if ($env:DATA_FILE -and $env:DATA_FILE.Trim() -ne "") {
            $candidate = Join-Path $env:WORKSPACE $env:DATA_FILE

            if ((Test-Path $candidate) -and -not (Test-Path $candidate -PathType Container)) {
              $uploadFile = $candidate
            }
          }

          if ($uploadFile) {
            Write-Host "Uploading $uploadFile to ${server}:${env:PROD_APP_DIR}/imports/${env:IMPORT_FILE}"
            scp -i "$keyFile" -o StrictHostKeyChecking=no "$uploadFile" "${server}:${env:PROD_APP_DIR}/imports/${env:IMPORT_FILE}"
          } else {
            Write-Host "No DATA_FILE uploaded. Will use existing server file: ${env:PROD_APP_DIR}/imports/${env:IMPORT_FILE}"
          }
          '''
        }
      }
    }

    stage('Run Data Action') {
      steps {
        withCredentials([
          string(
            credentialsId: 'vn-biodiversity-prod-ssh-key-b64',
            variable: 'PROD_SSH_KEY_B64'
          )
        ]) {
          powershell '''
          $ErrorActionPreference = "Stop"

          $remoteScript = @'
set -euo pipefail

APP_DIR="__APP_DIR__"
DB_SERVICE="__DB_SERVICE__"
API_SERVICE="__API_SERVICE__"
DB_USER="__DB_USER__"
DB_NAME="__DB_NAME__"
DATA_ACTION="__DATA_ACTION__"
IMPORT_FILE="__IMPORT_FILE__"
RESTART_API="__RESTART_API__"

IMPORT_PATH="$APP_DIR/imports/$IMPORT_FILE"
PREPARE_SQL="__PREPARE_REMOTE__"
TABLE_MANIFEST="__TABLE_MANIFEST_REMOTE__"
BACKUP_PATH="$APP_DIR/backups/prod-before-replace-$(date +%Y%m%d-%H%M%S).sql"

echo "DATA_ACTION=$DATA_ACTION"
echo "IMPORT_PATH=$IMPORT_PATH"
echo "DB_NAME=$DB_NAME"

if [ "$DATA_ACTION" = "dry-run" ]; then
  echo "Dry run only"
  ls -lh "$IMPORT_PATH" || true
  cd "$APP_DIR"
  docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -U "$DB_USER" -Atc "SELECT datname FROM pg_database WHERE datistemplate = false;"
  exit 0
fi

if [ ! -s "$IMPORT_PATH" ]; then
  echo "ERROR: Import file not found or empty: $IMPORT_PATH"
  exit 1
fi

require_file_table_data() {
  table="$1"

  if ! printf '%s\n' "$IMPORT_TABLES" | grep -Eq "^(COPY|INSERT INTO) public\\.${table}$"; then
    echo "ERROR: Import file is missing data for public.$table"
    echo "Refusing to replace production data before truncate."
    exit 1
  fi
}

verify_table_exists() {
  table="$1"
  exists=$(docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -Atc "SELECT to_regclass('public.$table') IS NOT NULL;")

  if [ "$exists" != "t" ]; then
    echo "ERROR: Required production table does not exist: public.$table"
    exit 1
  fi
}

if [ ! -s "$TABLE_MANIFEST" ]; then
  echo "ERROR: Data table manifest not found or empty: $TABLE_MANIFEST"
  exit 1
fi

mapfile -t DATA_TABLES < <(
  sed 's/\r$//' "$TABLE_MANIFEST" |
    sed '/^[[:space:]]*$/d; /^[[:space:]]*#/d'
)

if [ "${#DATA_TABLES[@]}" -eq 0 ]; then
  echo "ERROR: Data table manifest contains no tables"
  exit 1
fi

for table in "${DATA_TABLES[@]}"; do
  if ! printf '%s\n' "$table" | grep -Eq '^[a-z0-9_]+$'; then
    echo "ERROR: Invalid table name in manifest: $table"
    exit 1
  fi
done

TABLE_LIST_SQL=$(printf "'%s'," "${DATA_TABLES[@]}")
TABLE_LIST_SQL="${TABLE_LIST_SQL%,}"

echo "Checking database exists"
cd "$APP_DIR"
docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -c "SELECT current_database();"

echo "Prepare species import schema"
docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" < "$PREPARE_SQL"

if [ "$DATA_ACTION" = "replace-data" ]; then
  echo "Preflight import file content"
  IMPORT_TABLES=$(grep -Eo "^(COPY|INSERT INTO) public\\.[A-Za-z0-9_]+" "$IMPORT_PATH" || true)
  echo "$IMPORT_TABLES" | sort -u
  IMPORT_HAS_SCHEMA=$(grep -Eq "^CREATE TABLE public\\.[A-Za-z0-9_]+" "$IMPORT_PATH" && echo "yes" || echo "no")
  echo "IMPORT_HAS_SCHEMA=$IMPORT_HAS_SCHEMA"

  for table in "${DATA_TABLES[@]}"; do
    require_file_table_data "$table"
  done

  if [ "$IMPORT_HAS_SCHEMA" = "yes" ]; then
    echo "Schema dump detected. Production table existence check will be handled by restore."
  else
    echo "Preflight production schema"
    for table in "${DATA_TABLES[@]}"; do
      verify_table_exists "$table"
    done
  fi
fi

if [ "$DATA_ACTION" = "sql-import" ]; then
  echo "Import SQL only, no truncate"
  docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" < "$IMPORT_PATH"
fi

if [ "$DATA_ACTION" = "replace-data" ]; then
  echo "Backup production data before replace: $BACKUP_PATH"
  docker compose --env-file .env.docker exec -T "$DB_SERVICE" pg_dump -U "$DB_USER" -d "$DB_NAME" --data-only > "$BACKUP_PATH"

  if [ "$IMPORT_HAS_SCHEMA" = "yes" ]; then
    echo "Import file contains schema. Dropping imported public tables before restore."
    mapfile -t IMPORTED_TABLES < <(grep -Eo "^(COPY|CREATE TABLE|INSERT INTO) public\\.[A-Za-z0-9_]+" "$IMPORT_PATH" |
      sed -E 's/^(COPY|CREATE TABLE|INSERT INTO) public\\.//' |
      sort -u)

    if [ "${#IMPORTED_TABLES[@]}" -eq 0 ]; then
      echo "ERROR: Could not detect imported table names from schema dump"
      exit 1
    fi

    for table in "${IMPORTED_TABLES[@]}"; do
      if ! printf '%s\n' "$table" | grep -Eq '^[A-Za-z0-9_]+$'; then
        echo "ERROR: Invalid imported table name detected: $table"
        exit 1
      fi

      echo "DROP TABLE IF EXISTS public.$table CASCADE"
      docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" \
        -c "DROP TABLE IF EXISTS public.\"$table\" CASCADE;"
    done
  else
    echo "Truncate existing business data tables only"
    TRUNCATE_SQL=$(docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -Atc "
      SELECT 'TRUNCATE TABLE ' ||
        string_agg(format('%I.%I', schemaname, tablename), ', ') ||
        ' RESTART IDENTITY CASCADE;'
      FROM pg_tables
      WHERE schemaname = 'public'
        AND tablename IN ($TABLE_LIST_SQL);
    ")

    echo "$TRUNCATE_SQL"

    if [ -z "$TRUNCATE_SQL" ]; then
      echo "ERROR: No matching business tables found to truncate"
      exit 1
    fi

    docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -c "$TRUNCATE_SQL"
  fi

  echo "Import replacement SQL"
  docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" < "$IMPORT_PATH"

  echo "Analyze database"
  docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -c "ANALYZE;"

  echo "Clean old uploaded data files, keep current import only"
  find "$APP_DIR/imports" -maxdepth 1 -type f -name 'vnsc-data-update-*.sql' ! -name "$IMPORT_FILE" -delete
  ls -lh "$APP_DIR/imports" || true

  echo "Verify imported data counts"
  COUNTS=$(docker compose --env-file .env.docker exec -T "$DB_SERVICE" psql -v ON_ERROR_STOP=1 -U "$DB_USER" -d "$DB_NAME" -Atc "
    SELECT
      (
        (SELECT count(*) FROM public.animal_db_vn) +
        (SELECT count(*) FROM public.plant_db_vn) +
        (SELECT count(*) FROM public.insect_db_vn) +
        (SELECT count(*) FROM public.fungi_db_vn) +
        (SELECT count(*) FROM public.algae_db_vn) +
        (SELECT count(*) FROM public.protista_db_vn)
      )::text || '|' ||
      (SELECT count(*) FROM public.vnredlist_profiles)::text || '|' ||
      (SELECT count(*) FROM public.species_vnredlist_matches)::text || '|' ||
      (SELECT count(*) FROM public.species_showpic_metadata)::text || '|' ||
      (SELECT count(*) FROM public.taxa)::text || '|' ||
      (SELECT count(*) FROM public.taxon_names)::text || '|' ||
      (SELECT count(*) FROM public.taxon_closure)::text || '|' ||
      (SELECT count(*) FROM public.species_taxonomy)::text || '|' ||
      (SELECT count(*) FROM public.gbif_taxonomy_cache)::text || '|' ||
      (SELECT count(*) FROM public.gbif_occurrences)::text || '|' ||
      (
        SELECT count(*)
        FROM public.gbif_occurrences
        WHERE latitude BETWEEN 8.2 AND 23.5
          AND longitude BETWEEN 102.1 AND 109.7
          AND latitude IS NOT NULL
          AND longitude IS NOT NULL
          AND coalesce(has_geospatial_issue, false) = false
      )::text;
  ")

  IFS='|' read -r SPECIES_COUNT REDLIST_COUNT REDLIST_MATCH_COUNT SHOWPIC_COUNT TAXA_COUNT TAXON_NAMES_COUNT TAXON_CLOSURE_COUNT SPECIES_TAXONOMY_COUNT GBIF_TAXONOMY_CACHE_COUNT GBIF_OCCURRENCES_COUNT VALID_OCCURRENCES_COUNT <<EOF_COUNTS
$COUNTS
EOF_COUNTS

  echo "species_count=$SPECIES_COUNT"
  echo "vnredlist_profiles_count=$REDLIST_COUNT"
  echo "species_vnredlist_matches_count=$REDLIST_MATCH_COUNT"
  echo "species_showpic_metadata_count=$SHOWPIC_COUNT"
  echo "taxa_count=$TAXA_COUNT"
  echo "taxon_names_count=$TAXON_NAMES_COUNT"
  echo "taxon_closure_count=$TAXON_CLOSURE_COUNT"
  echo "species_taxonomy_count=$SPECIES_TAXONOMY_COUNT"
  echo "gbif_taxonomy_cache_count=$GBIF_TAXONOMY_CACHE_COUNT"
  echo "gbif_occurrences_count=$GBIF_OCCURRENCES_COUNT"
  echo "valid_occurrences_count=$VALID_OCCURRENCES_COUNT"

  if [ "$SPECIES_COUNT" -le 0 ]; then
    echo "ERROR: species_count is zero after import"
    exit 1
  fi

  if [ "$REDLIST_COUNT" -le 0 ]; then
    echo "ERROR: vnredlist_profiles_count is zero after import"
    exit 1
  fi

  if [ "$REDLIST_MATCH_COUNT" -le 0 ]; then
    echo "ERROR: species_vnredlist_matches_count is zero after import"
    exit 1
  fi

  if [ "$SHOWPIC_COUNT" -le 0 ]; then
    echo "ERROR: species_showpic_metadata_count is zero after import"
    exit 1
  fi

  if [ "$TAXA_COUNT" -le 0 ] || [ "$TAXON_NAMES_COUNT" -le 0 ] || [ "$TAXON_CLOSURE_COUNT" -le 0 ] || [ "$SPECIES_TAXONOMY_COUNT" -le 0 ]; then
    echo "ERROR: taxonomy tables are incomplete after import"
    exit 1
  fi

  if [ "$GBIF_TAXONOMY_CACHE_COUNT" -le 0 ]; then
    echo "ERROR: gbif_taxonomy_cache_count is zero after import"
    exit 1
  fi

  if [ "$GBIF_OCCURRENCES_COUNT" -le 0 ] || [ "$VALID_OCCURRENCES_COUNT" -le 0 ]; then
    echo "ERROR: gbif_occurrences is empty or has no valid Vietnam coordinates after import"
    exit 1
  fi
fi

if [ "$DATA_ACTION" = "csv-import" ]; then
  echo "CSV import is not configured yet"
  exit 1
fi

if [ "$DATA_ACTION" = "seed-script" ]; then
  echo "Seed script is not configured yet"
  exit 1
fi

if [ "$RESTART_API" = "yes" ]; then
  echo "Restart API"
  docker compose --env-file .env.docker restart "$API_SERVICE"
fi

echo "Done"
'@

          $remoteScript = $remoteScript `
            -replace '__APP_DIR__', $env:PROD_APP_DIR `
            -replace '__DB_SERVICE__', $env:DATA_DB_SERVICE `
            -replace '__API_SERVICE__', $env:DATA_API_SERVICE `
            -replace '__DB_USER__', $env:DATA_DB_USER `
            -replace '__DB_NAME__', $env:DATA_DB_NAME `
            -replace '__PREPARE_REMOTE__', $env:PREPARE_REMOTE `
            -replace '__TABLE_MANIFEST_REMOTE__', $env:TABLE_MANIFEST_REMOTE `
            -replace '__DATA_ACTION__', $env:DATA_ACTION `
            -replace '__IMPORT_FILE__', $env:IMPORT_FILE `
            -replace '__RESTART_API__', $env:RESTART_API

          $scriptPath = Join-Path $env:WORKSPACE "remote-update-data.sh"
          $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
          [System.IO.File]::WriteAllText($scriptPath, $remoteScript, $utf8NoBom)

          $keyFile = Join-Path $env:WORKSPACE ".jenkins-prod-key-$env:BUILD_NUMBER"
          if (-not (Test-Path $keyFile)) {
            [IO.File]::WriteAllBytes($keyFile, [Convert]::FromBase64String($env:PROD_SSH_KEY_B64))
            icacls $keyFile /inheritance:r | Out-Null
            $account = whoami
            icacls $keyFile /grant:r "${account}:R" | Out-Null
          }

          $server = "$env:PROD_USER@$env:PROD_HOST"
          scp -i "$keyFile" -o StrictHostKeyChecking=no "$scriptPath" "${server}:/tmp/vnsc-update-data.sh"
          ssh -i "$keyFile" -o StrictHostKeyChecking=no "$server" "bash /tmp/vnsc-update-data.sh"
          '''
        }
      }
    }
  }

  post {
    always {
      powershell '''
        $keyFile = Join-Path $env:WORKSPACE ".jenkins-prod-key-$env:BUILD_NUMBER"
        if (Test-Path $keyFile) {
          Remove-Item -Force $keyFile
        }
      '''
    }
  }
}
