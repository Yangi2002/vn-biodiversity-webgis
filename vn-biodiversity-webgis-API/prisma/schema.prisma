generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model app_users {
  user_id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String       @unique
  display_name  String?
  password_hash String
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  user_roles    user_roles[]
}

model national_parks_vn {
  park_id              String                 @id(map: "pk_national_parks_vn")
  source               String?
  map_url              String?
  detail_url           String?
  slug                 String?
  title                String?
  map_popup_title      String?
  map_popup_excerpt    String?
  author               String?
  thumbnail_url        String?
  tom_tat              String?
  quyet_dinh_thanh_lap String?
  toa_do_dia_ly        String?
  quy_mo_dien_tich     String?
  muc_tieu_nhiem_vu    String?
  co_quan_cap_quan_ly  String?
  ban_quan_ly          String?
  vi_tri_dia_ly        String?
  da_dang_sinh_hoc     String?
  he_thuc_vat          String?
  he_dong_vat          String?
  hoat_dong_du_lich    String?
  du_an_lien_quan      String?
  dan_so_trong_vung    String?
  nguon_tham_khao      String?
  detail_sections_json String?
  content_text         String?
  image_urls           String?
  image_captions       String?
  image_group_id       String?
  primary_image_url    String?
  primary_image_path   String?
  image_count          String?
  local_image_paths    String?
  image_metadata_json  String?
  source_payload       String?
  map_latitude         String?
  map_longitude        String?
  latitude             String?
  longitude            String?
  marker_order         String?
  marker_record_json   String?
  national_park_images national_park_images[]

  @@index([detail_url], map: "idx_national_parks_vn_detail_url")
  @@index([title], map: "idx_national_parks_vn_title")
}

model user_roles {
  user_role_id BigInt    @id @default(autoincrement())
  user_id      String    @db.Uuid
  role_code    String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  app_users    app_users @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_code], map: "uq_user_roles_user_role")
  @@index([role_code], map: "idx_user_roles_role")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model animal_db_vn {
  source_loai                     String?
  species_id                      String                            @id(map: "pk_animal_db_vn")
  detail_url                      String?
  page                            String?
  hinh                            String?
  ten_viet_nam                    String?
  ten_latin                       String?
  ho                              String?
  bo                              String?
  lop_nhom                        String?
  title_block                     String?
  dac_diem_nhan_dang              String?
  sinh_hoc_sinh_thai              String?
  phan_bo                         String?
  phan_hang                       String?
  gia_tri                         String?
  tinh_trang                      String?
  bien_phap_bao_ve                String?
  tai_lieu_dan                    String?
  mo_ta                           String?
  mo_ta_loai                      String?
  ban_do_phan_bo_cua_loai         String?
  list_ten_viet_nam               String?
  list_ten_latin                  String?
  dac_diem_bo_sung                String?
  kich_thuoc                      String?
  mau_mo_ta                       String?
  species_conservation_terms      species_conservation_terms[]
  species_gbif_occurrence_matches species_gbif_occurrence_matches[]
  species_images                  species_images[]
  species_keyword_links           species_keyword_links[]
  species_showpic_metadata        species_showpic_metadata[]
  species_taxonomy                species_taxonomy[]
  species_vnredlist_matches       species_vnredlist_matches[]

  @@index([species_id], map: "idx_animal_db_vn_species_id")
  @@index([ten_latin], map: "idx_animal_db_vn_ten_latin")
  @@index([ten_viet_nam], map: "idx_animal_db_vn_ten_viet_nam")
}

model conservation_terms {
  term_id                    BigInt                       @id @default(autoincrement())
  term_text                  String
  normalized_term            String
  term_type                  String
  category_code              String?
  criteria_code              String                       @default("")
  canonical_url              String?
  description                String?
  severity_order             Int?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  species_conservation_terms species_conservation_terms[]

  @@unique([normalized_term, term_type, criteria_code])
  @@index([normalized_term], map: "idx_conservation_terms_normalized")
  @@index([term_type], map: "idx_conservation_terms_type")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model gbif_occurrences {
  gbif_occurrence_key             BigInt                            @id
  gbif_taxon_key                  BigInt?
  image_url                       String?
  latitude                        Float?
  longitude                       Float?
  observed_date                   String?
  location                        String?
  observer                        String?
  quality_grade                   String?
  basis_of_record                 String?
  has_geospatial_issue            Boolean?
  issues                          Json?
  occurrence_url                  String?
  source_payload                  Json?
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  species_gbif_occurrence_matches species_gbif_occurrence_matches[]

  @@index([observed_date], map: "idx_gbif_occurrences_date")
  @@index([latitude, longitude], map: "idx_gbif_occurrences_geo")
  @@index([gbif_taxon_key], map: "idx_gbif_occurrences_taxon")
  @@index([latitude, longitude, gbif_occurrence_key], map: "idx_gbif_occurrences_vn_geo_valid", where: raw("((latitude IS NOT NULL) AND (longitude IS NOT NULL) AND (COALESCE(has_geospatial_issue, false) = false))"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model gbif_taxonomy_cache {
  source_table             String
  species_id               String
  original_scientific_name String
  query_name               String
  gbif_usage_key           BigInt?
  gbif_accepted_usage_key  BigInt?
  match_type               String?
  confidence               Int?
  status                   String?
  gbif_rank                String?
  accepted_scientific_name String?
  canonical_name           String?
  kingdom                  String?
  phylum                   String?
  class_name               String?
  order_name               String?
  family                   String?
  genus                    String?
  species                  String?
  gbif_raw                 Json?
  fetched_at               DateTime @db.Timestamptz(6)

  @@id([source_table, species_id])
  @@index([query_name], map: "idx_gbif_taxonomy_cache_query")
  @@index([species], map: "idx_gbif_taxonomy_cache_species")
}

